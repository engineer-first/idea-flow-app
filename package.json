{
  "name": "idea-flow-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:boundaries": "ast-grep scan",
    "fix": "biome check --write",
    "format": "biome format --write",
    "cf-typegen": "wrangler types --config workers/wrangler.jsonc workers/worker-configuration.d.ts",
    "typecheck": "npm run cf-typegen && tsc --noEmit && tsc -p workers/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "dev:api": "wrangler dev --config workers/wrangler.jsonc --port 8787",
    "db:migrate": "wrangler d1 migrations apply DB --local --config workers/wrangler.jsonc",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && wrangler dev -c wrangler.jsonc -c workers/wrangler.jsonc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@biomejs/biome": "^2.5.1",
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "storybook": "^10.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
