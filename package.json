{
  "name": "idea-flow-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:boundaries": "ast-grep scan",
    "check:migrations": "bash scripts/check-migration-numbers.sh",
    "fix": "biome check --write",
    "format": "biome format --write",
    "cf-typegen": "wrangler types --config workers/wrangler.jsonc workers/worker-configuration.d.ts",
    "typecheck": "npm run cf-typegen && tsc --noEmit && tsc -p workers/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "pretest:workers": "npm run gen:room-do-migrations",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "predev:api": "npm run gen:room-do-migrations",
    "dev:api": "wrangler dev --config workers/wrangler.jsonc --port 8787",
    "db:migrate": "wrangler d1 migrations apply DB --local --config workers/wrangler.jsonc",
    "db:schema:d1": "node --no-warnings scripts/build-d1-schema.mts",
    "db:schema:room-do": "node --no-warnings scripts/build-room-do-schema.mts",
    "db:schema:diagrams": "npm run db:schema:d1 && npm run db:schema:room-do && tbls doc --config .tbls/d1.yml --rm-dist && tbls doc --config .tbls/room-do.yml --rm-dist",
    "db:schema:lint": "npm run db:schema:d1 && npm run db:schema:room-do && tbls lint --config .tbls/d1.yml && tbls lint --config .tbls/room-do.yml",
    "postinstall": "npm run gen:room-do-migrations",
    "gen:room-do-migrations": "node scripts/generate-room-do-migrations.mjs",
    "new:room-do-migration": "node scripts/new-room-do-migration.mjs",
    "predeploy:api": "npm run gen:room-do-migrations",
    "deploy:api": "wrangler deploy --config workers/wrangler.jsonc",
    "build:cf": "opennextjs-cloudflare build",
    "prepreview:cf": "npm run gen:room-do-migrations",
    "preview:cf": "opennextjs-cloudflare build && wrangler dev -c wrangler.jsonc -c workers/wrangler.jsonc",
    "presmoke": "npm run gen:room-do-migrations",
    "smoke": "bash scripts/smoke-test.sh",
    "storybook": "npm run db:schema:diagrams && storybook dev -p 6006",
    "build-storybook": "npm run db:schema:diagrams && storybook build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@biomejs/biome": "^2.5.1",
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "chromatic": "^18.0.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "storybook": "^10.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
