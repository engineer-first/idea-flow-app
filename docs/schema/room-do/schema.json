{
  "name": "RoomDO (room内部)",
  "desc": "ルーム1つにつき1つ生成される SQLite-backed Durable Object の内部スキーマ。 メンバーシップと付箋の確定状態の真実をここで持つ。D1 の rooms.id はこの DO インスタンスに対応するが、DBレベルでの結合は存在しない（アプリケーション コード上でのみ対応づけられる）。D1 側は .tbls/d1.yml を参照。",
  "tables": [
    {
      "name": "members",
      "type": "table",
      "columns": [
        {
          "name": "user_id",
          "type": "TEXT",
          "nullable": true
        },
        {
          "name": "joined_at",
          "type": "TEXT",
          "nullable": false,
          "default": "datetime('now')"
        }
      ],
      "indexes": [
        {
          "name": "sqlite_autoindex_members_1",
          "def": "PRIMARY KEY (user_id)",
          "table": "members",
          "columns": ["user_id"]
        }
      ],
      "constraints": [
        {
          "name": "user_id",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (user_id)",
          "table": "members",
          "columns": ["user_id"]
        },
        {
          "name": "sqlite_autoindex_members_1",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (user_id)",
          "table": "members",
          "columns": ["user_id"]
        }
      ],
      "def": "CREATE TABLE members (\n     user_id TEXT PRIMARY KEY,\n     joined_at TEXT NOT NULL DEFAULT (datetime('now'))\n   )"
    },
    {
      "name": "notes",
      "type": "table",
      "columns": [
        {
