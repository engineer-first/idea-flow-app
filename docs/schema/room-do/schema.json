          "type": "TEXT",
          "nullable": false
        },
        {
          "name": "content",
          "type": "TEXT",
          "nullable": false,
          "default": "''"
        },
        {
          "name": "x",
          "type": "REAL",
          "nullable": false
        },
        {
          "name": "y",
          "type": "REAL",
          "nullable": false
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "nullable": false
        },
        {
          "name": "updated_at",
          "type": "TEXT",
          "nullable": false
        }
      ],
      "indexes": [
        {
          "name": "sqlite_autoindex_notes_1",
          "def": "PRIMARY KEY (id)",
          "table": "notes",
          "columns": ["id"]
        }
      ],
      "constraints": [
        {
          "name": "id",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "notes",
          "columns": ["id"]
        },
        {
          "name": "sqlite_autoindex_notes_1",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "notes",
          "columns": ["id"]
        }
      ],
      "def": "CREATE TABLE notes (\n     id TEXT PRIMARY KEY,\n     author_id TEXT NOT NULL,\n     content TEXT NOT NULL DEFAULT '',\n     x REAL NOT NULL,\n     y REAL NOT NULL,\n     created_at TEXT NOT NULL,\n     updated_at TEXT NOT NULL\n   )"
    }
  ],
  "driver": {
    "name": "sqlite",
    "database_version": "3.51.3"
  }
}
