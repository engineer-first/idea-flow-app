# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# storybook
/storybook-static/
build-storybook.log

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext / Cloudflare
.open-next/
.wrangler/
workers/worker-configuration.d.ts

# Storybook build output
storybook-static/
build-storybook.log

# Playwright MCP artifacts
.playwright-mcp/

# wrangler local secrets
.dev.vars
workers/.dev.vars
workers/.wrangler/

# schema doc生成用の一時sqliteファイル（scripts/build-*-schema.ts が生成）
/tmp/*.sqlite
