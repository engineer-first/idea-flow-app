{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "project": {
      "command": ["bash", "scripts/format-file.sh", "$FILE"],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".mjs",
        ".cjs",
        ".json",
        ".css",
        ".scss",
        ".md",
        ".mdx"
      ]
    }
  }
}
